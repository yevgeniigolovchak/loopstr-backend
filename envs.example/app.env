# DJANGO
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=SET_DJANGO_SECRET_KEY_HERE
DJANGO_DEBUG=yes
DJANGO_ALLOWED_HOSTS=*

# DJANGO REST FRAMEWORK
# ------------------------------------------------------------------------------
DRF_ENABLE_BROWSABLE_API_RENDERER=no

# API DOCUMENTATION
# ------------------------------------------------------------------------------
# Serves /docs/ and /schema/. Off means the routes are not registered at all.
DJANGO_API_DOCS_ENABLED=yes

# SESSIONS
# ------------------------------------------------------------------------------
# Off locally only: the development server speaks HTTP, and a Secure cookie never comes back.
# It defaults to on, so an environment that omits this line keeps the cookie off the wire.
DJANGO_SESSION_COOKIE_SECURE=no
# How long "remember me" keeps the session alive, in seconds. 2592000 = 30 days.
DJANGO_SESSION_COOKIE_AGE=2592000

# CROSS-ORIGIN REQUESTS
# ------------------------------------------------------------------------------
# The frontend origins, comma-separated. No wildcard: credentialed CORS forbids one.
#
# These must share a registrable domain with the API's own host (`app.example.com` and
# `api.example.com` do; `something.vercel.app` and `api.example.com` do not). The session cookie is
# `SameSite=Lax`, which the browser withholds cross-site: CORS would still pass, the login would
# still answer 200, and every request after it would arrive anonymous.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# AUTHENTICATION
# ------------------------------------------------------------------------------
# Failed logins before the account locks, and how many minutes the lock lasts. Both must be 1 or
# greater — the app refuses to start otherwise, because 0 means "lock on the first typo" and
# "unlock immediately" rather than "off".
DJANGO_AUTH_LOCKOUT_MAX_ATTEMPTS=5
DJANGO_AUTH_LOCKOUT_MINUTES=15
