# DJANGO
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=SET_DJANGO_SECRET_KEY_HERE
DJANGO_DEBUG=yes
DJANGO_ALLOWED_HOSTS=*

# DJANGO REST FRAMEWORK
# ------------------------------------------------------------------------------
DRF_ENABLE_BROWSABLE_API_RENDERER=no

# API DOCUMENTATION
# ------------------------------------------------------------------------------
# Serves /docs/ and /schema/. Off means the routes are not registered at all.
DJANGO_API_DOCS_ENABLED=yes
